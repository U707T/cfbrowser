<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- 自适应安全区：整体缩到 78% -->
    <group
        android:scaleX="0.373"
        android:scaleY="0.373"
        android:pivotX="512"
        android:pivotY="512">

        <!-- 球体下方的柔和阴影 -->
        <path android:pathData="M292 540 a220 56 0 1 0 440 0 a220 56 0 1 0 -440 0 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="512"
                    android:centerY="540"
                    android:gradientRadius="240">
                    <item android:offset="0" android:color="#33000000"/>
                    <item android:offset="1" android:color="#00000000"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- 球体 -->
        <path android:pathData="M280 512 a232 232 0 1 0 464 0 a232 232 0 1 0 -464 0 Z">
      <aapt:attr name="android:fillColor">
        <gradient
            android:type="radial"
            android:centerX="420"
            android:centerY="400"
            android:gradientRadius="370">
          <item android:offset="0" android:color="#EF9B78"/>
          <item android:offset="0.55" android:color="#D97757"/>
          <item android:offset="1" android:color="#B8553B"/>
        </gradient>
      </aapt:attr>
        </path>

        <!-- 轨道 -->
        <group
            android:rotation="-22"
            android:pivotX="512"
            android:pivotY="512">
            <path
                android:fillColor="#00000000"
                android:strokeColor="#F4EFE5"
                android:strokeWidth="14"
                android:strokeAlpha="0.55"
                android:pathData="M120 512 a392 142 0 1 0 784 0 a392 142 0 1 0 -784 0 Z" />
        </group>

        <!-- 轨道上的小点 -->
        <path
            android:fillColor="#F4EFE5"
            android:pathData="M802 340 a26 26 0 1 0 52 0 a26 26 0 1 0 -52 0 Z" />

        <!-- 球体高光 -->
        <group
            android:rotation="-30"
            android:pivotX="430"
            android:pivotY="420">
            <path
                android:fillColor="#FFFFFF"
                android:fillAlpha="0.18"
                android:pathData="M358 420 a72 42 0 1 0 144 0 a72 42 0 1 0 -144 0 Z" />
        </group>
    </group>
</vector>
