<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- 自适应前景：标记占可见区 70%（1024 视口 → 108dp 画布，可见区 = 中央 72dp） -->
    <group
        android:scaleX="0.6669"
        android:scaleY="0.6669"
        android:pivotX="512"
        android:pivotY="512">

        <!-- 球体下方的独立柔影：圆 + 径向渐变 + 纵向压扁，避免椭圆渐变的硬边 -->
        <group
            android:pivotX="512"
            android:pivotY="815"
            android:scaleY="0.306452">
            <path android:pathData="M264 815 a248 248 0 1 0 496 0 a248 248 0 1 0 -496 0 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="radial"
                        android:centerX="512"
                        android:centerY="815"
                        android:gradientRadius="248">
                        <item android:offset="0" android:color="#38000000"/>
                        <item android:offset="0.55" android:color="#2C000000"/>
                        <item android:offset="1" android:color="#00000000"/>
                    </gradient>
                </aapt:attr>
            </path>
        </group>

        <!-- 轨道后半圈：先画，被球体挡住 -->
        <group
            android:rotation="-22"
            android:pivotX="512"
            android:pivotY="512">
            <clip-path android:pathData="M0 0 H1024 V512 H0 Z" />
            <path
                android:fillColor="#00000000"
                android:strokeColor="#D97757"
                android:strokeWidth="16"
                android:strokeAlpha="0.8"
                android:pathData="M138 512 a374 136 0 1 0 748 0 a374 136 0 1 0 -748 0 Z" />
        </group>

        <!-- 球体 -->
        <path android:pathData="M289 512 a223 223 0 1 0 446 0 a223 223 0 1 0 -446 0 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="422.8"
                    android:centerY="404.96"
                    android:gradientRadius="356.8">
                    <item android:offset="0" android:color="#FFFDF8"/>
                    <item android:offset="0.55" android:color="#F1E8D9"/>
                    <item android:offset="1" android:color="#D8CAB6"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- 轨道前半圈：补回球体之上 -->
        <group
            android:rotation="-22"
            android:pivotX="512"
            android:pivotY="512">
            <clip-path android:pathData="M0 512 H1024 V1024 H0 Z" />
            <path
                android:fillColor="#00000000"
                android:strokeColor="#D97757"
                android:strokeWidth="16"
                android:strokeAlpha="0.8"
                android:pathData="M138 512 a374 136 0 1 0 748 0 a374 136 0 1 0 -748 0 Z" />
        </group>

        <!-- 轨道点：圆心压在轨道中心线上 -->
        <group
            android:rotation="-22"
            android:pivotX="512"
            android:pivotY="512">
            <path
                android:fillColor="#D97757"
                android:fillAlpha="0.95"
                android:pathData="M847.695 469.974 a20 20 0 1 0 40 0 a20 20 0 1 0 -40 0 Z" />
        </group>

        <!-- 球体高光 -->
        <group
            android:rotation="-30"
            android:pivotX="433.281"
            android:pivotY="423.469">
            <path
                android:fillColor="#FFFFFF"
                android:fillAlpha="0.18"
                android:pathData="M364.151 423.469 a69.13 40.363 0 1 0 138.26 0 a69.13 40.363 0 1 0 -138.26 0 Z" />
        </group>
    </group>
</vector>
